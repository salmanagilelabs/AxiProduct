tion (result) {\r\n                if (result && result.pending) {\r\n                  dlg.hideLoading();\r\n                  resolve(finish(false));\r\n                  return;\r\n                }\r\n                dlg.close();\r\n                resolve(finish(true));\r\n              }).catch(function () {\r\n                dlg.hideLoading();\r\n                resolve(finish(false));\r\n              });\r\n              return false;\r\n            }\r\n          },\r\n          draft: {\r\n            text: \"Draft Save\",\r\n            action: function () {\r\n              var dlg = this;\r\n              dlg.showLoading();\r\n              smartviewRunSaveFlow({\r\n                mode: \"draft\",\r\n                successMessage: \"\",\r\n                silentSuccess: true\r\n              }).then(function () {\r\n                dlg.close();\r\n                resolve(finish(true));\r\n              }).catch(function () {\r\n                dlg.hideLoading();\r\n                resolve(finish(false));\r\n              });\r\n              return false;\r\n            }\r\n          },\r\n          discard: {\r\n            text: \"Discard\",\r\n            btnClass: \"btn-danger\",\r\n            action: function () {\r\n              var dlg = this;\r\n              dlg.showLoading();\r\n              smartviewRunSaveFlow({\r\n                mode: \"discard\",\r\n                successMessage: \"\",\r\n                silentSuccess: true\r\n              }).then(function () {\r\n                dlg.close();\r\n                resolve(finish(true));\r\n              }).catch(function () {\r\n                dlg.hideLoading();\r\n                resolve(finish(false));\r\n              });\r\n              return false;\r\n            }\r\n          },\r\n          cancel: {\r\n            text: \"Cancel\",\r\n            action: function () {\r\n              resolve(finish(false));\r\n            }\r\n          }\r\n        },\r\n        onDes