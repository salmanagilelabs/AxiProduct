ymbol-label {\r\n  background:#fdefd8!important\r\n}\r\n#selectedEntitiesContainer .EntityData_Select-lists:nth-child(6n+2) .symbol-label {\r\n  background:#f4f9fe!important\r\n}\r\n#selectedEntitiesContainer .EntityData_Select-lists:nth-child(6n+3) .symbol-label {\r\n  background:#fbe4f7!important\r\n}\r\n#selectedEntitiesContainer .EntityData_Select-lists:nth-child(6n+4) .symbol-label {\r\n  background:#e5f2ff!important\r\n}\r\n#selectedEntitiesContainer .EntityData_Select-lists:nth-child(6n+5) .symbol-label {\r\n  background:#e6fffb!important\r\n}\r\n#selectedEntitiesContainer .EntityData_Select-lists:nth-child(6n+6) .symbol-label {\r\n  background:#fbe5e5!important\r\n}\r\n.search-container {\r\n  width:calc(100vh - 200px)!important\r\n}\r\n#entityModal .modal-footer {\r\n  padding:8px 32px!important\r\n}\r\n\r\n\r\n\r\n/* New Layout customization */\r\n#dv_EntityContainer li.nav-item .symbol {\r\n  display: none;\r\n}\r\n#Entity_Summary_Wrapper ul.nav .nav-item:has(.nav-link.active) {\r\n  background: #0f0f0f !important;\r\n  border-bottom: 0 !important;\r\n  border-radius: 4px;\r\n}\r\n#Entity_Summary_Wrapper .nav-item:has(.nav-link.active) a {\r\n  color: white !important;\r\n}\r\n#Entity_Summary_Wrapper ul.nav .nav-item {\r\n  background: #f2f2f2 !important;\r\n}\r\n.Chart-Header {\r\n  background: #f9f9fb;\r\n  padding: 0 15px;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  display: flex;\r\n  justify-content: space-between;\r\n}\r\n\r\n/* #Entity_summary_Left {\r\n  width: 104px;\r\n} */\r\n.analytics-container {\r\n  border: 1px solid #ececec;\r\n  /* padding-top: 10px; */\r\n  position: relative;\r\n}\r\n.material-icons.material-icons-style.material-icons-2 {\r\n\r\n  font-size: 17px !important;\r\n  line-height: 1;\r\n}\r\n\r\n#Entity_summary_Left, #Entity_summary_Right {\r\n    height: calc(100vh - 50px) !important;\r\n    min-height: calc(100vh - 50px) !important;\r\n}\r\n.card-footer-bottom {\r\n    opacity: 1 !important;\r\n    visibility: visible !important;\r\n    transition: opacity .6s ease-in-out;\r\n}\r\n.analytics-container:has(#KPI-2) {\r\n\tborder-left: 0 !important;\r\n\tpadding-block: 10px;\r\n}\r\n.Data-Group_Items:hover a .Data-Group-name {\r\n  color: green !important;\r\n}\r\n.card.Summary_Charts_Items {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 100%;\r\n}\r\n#Entity_summary_Left .card-body:hover{overflow: overlay;}\r\n\r\n\r\n\r\n/* .highcharts-root {\r\n  width: 100% !important;\r\n}\r\n\r\n.highcharts-container {\r\n  width: 100% !important;\r\n}\r\n#KPI-3 {\r\n\twidth: 100% !important;\r\n} \r\n\r\n.chart-selections {\r\n\tposition: absolute;\r\n\tright: 0;\r\n\ttop: -7px;\r\n} */\r\n.card.Summary_Charts_Items {\r\n\theight: 99% !important;\r\n}\r\n\r\n#chart-title {\r\n\tmargin-inline: 25px !important;\r\n}\r\n#KPI-3 #Homepage_CardsList.mb-8 {\r\n\tmargin-bottom: 0 !important;\r\n}\r\n.Summary_Charts .col-md-12.analytics-container {\r\n\tborder: 0 !important;\r\n}\r\n#Entity_Summary_Wrapper .card-header{ border-bottom: 0 !important; }\r\n\r\ng text {\r\n\tfont-size: 14px !important;\r\n\tfont-family: urbanist !important;\r\n\tfill: #333 !important;\r\n\tfont-weight: 600;\r\n}\r\n.chart-selections .dropdown-menu {\r\n\t border-radius: 0 !important; \r\n\tmargin-top: 36px;\r\n}\r\n/* .KC_Items_Content.collapse.show.min-h-300px.heightControl {\r\n\twidth:350px !important ;\r\n  height: 350px !important;\r\n} */\r\n\r\n\r\n\r\n\r\n#analytics-chart-title {\r\n\tfont-size: 20px;\r\n\tfont-weight: 700;\r\n\twidth: 99%;\r\n\tpadding-block: 4px;\r\n\t /* position: absolute; \r\n\tz-index: 9;\r\n  top: 25px; */\r\n  align-items: center;\r\n  border: 0;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  border: 0;\r\n}\r\n.chart-selections { \r\n\tmargin-top: 0 !important;\r\n}\r\n\r\n#Summary-Results .analytics-container .card-header {\r\n\tmin-height: 60px !important; \r\n\tbackground: #f9f9fb;\r\n\tborder-bottom: 1px solid #ececec !important;\r\n}\r\n#Summary-Results .col-md-8.analytics-container {\r\n\theight: 100%; padding-inline: 0;\r\n}\r\n#Entity_summary_Right .card-body.Summary_Charts {\r\n\theight: calc(100% - 60px);\r\n}\r\n.card.Summary_Charts_Items {\r\n\theight: 100% !important;\r\n\twidth: 100% !important;\r\n}\r\n#KPI-3.Summary_Charts_Items_Content {\r\n\twidth: 100%;\r\n\theight: 100%;\r\n}\r\n#KPI-3 #Homepage_CardsList.mb-8 {\r\n\tmargin-bottom: 0 !important;\r\n\twidth: 100%;\r\n\theight: 100%;\r\n}\r\n#KPI-3 #Homepage_CardsList_Wrapper {\r\n\twidth: 100% !important;\r\n\theight: 100% !important;\r\n}\r\n\r\n#KPI-3 #Homepage_CardsList_Wrapper .row {\r\n\theight: 100%;\r\n}\r\n#KPI-3 #Homepage_CardsList_Wrapper .row .card.KC_Items {\r\n\theight: 100%;\r\n\tdisplay: flex;\r\n\tjustify-content: center;\r\n}\r\n\r\n#Summary-Results #KPI-3 #Homepage_CardsList_Wrapper .KC_Items_Content {\r\n\twidth:100% !important ;\r\n  height: 95% !important;\r\n}\r\n\r\n/* Card Grid Analytics Layout */\r\n#Entity_Summary_Wrapper > .card-header.Page-title,\r\n#Entity_Summary_Wrapper > #analytics-grid-filter-summary {\r\n  flex: 0 0 100%;\r\n  max-width: 100%;\r\n  width: 100%;\r\n}\r\n\r\n#analytics-grid-filter-summary {\r\n  clear: both;\r\n}\r\n\r\n#Entity_Summary_Wrapper > #Analytics_Grid_Container,\r\n#Entity_Summary_Wrapper > #Analytics_Hyperlink_Panel {\r\n  align-self: flex-start;\r\n}\r\n\r\n#Analytics_Grid_Container {\r\n  padding: 10px 12px 16px;\r\n}\r\n\r\n.analytics-hyperlink-panel {\r\n  padding: 10px 12px 16px 0;\r\n}\r\n\r\n.analytics-hyperlink-panel .analytics-container {\r\n  background: transparent;\r\n  border-radius: 12px;\r\n  box-shadow: none;\r\n  height: calc(100vh - 170px);\r\n  overflow-y: auto;\r\n  padding: 4px;\r\n}\r\n\r\n.analytics-hyperlink-panel .card.KC_Items {\r\n  border: 0;\r\n  box-shadow: none;\r\n  margin-bottom: 0;\r\n}\r\n\r\n.analytics-hyperlink-item {\r\n  cursor: pointer;\r\n}\r\n\r\n.analytics-hyperlink-item.no-link {\r\n  cursor: default;\r\n}\r\n\r\n.analytics-hyperlink-panel .KC_Items_Content {\r\n  padding: 0;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List {\r\n  margin: 0;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap {\r\n  margin-bottom: 8px;\r\n  padding: 0 2px;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-item {\r\n  border-radius: 12px;\r\n  padding: 8px 14px;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-icon {\r\n  align-items: center;\r\n  display: flex;\r\n  height: 34px;\r\n  justify-content: center;\r\n  line-height: 1;\r\n  width: 34px;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-icon .material-icons {\r\n  color: #fff !important;\r\n  font-size: 18px !important;\r\n  line-height: 1 !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+1) .Invoice-item {\r\n  background: #fef5e6 !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+2) .Invoice-item {\r\n  background: #f4f9fe !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+3) .Invoice-item {\r\n  background: #fdf7fc !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+4) .Invoice-item {\r\n  background: #f4f9fe !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+5) .Invoice-item {\r\n  background: #e6fffb !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+6) .Invoice-item {\r\n  background: #f9f9f9 !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+1) .Invoice-icon {\r\n  background: #f4bc01 !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+2) .Invoice-icon {\r\n  background: #3d5996 !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+3) .Invoice-icon {\r\n  background: #e80502 !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+4) .Invoice-icon {\r\n  background: #539cfe !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+5) .Invoice-icon {\r\n  background: #3ddab4 !important;\r\n}\r\n\r\n.analytics-hyperlink-panel #Analytics_Hyperlink_List .Invoice-content-wrap:nth-child(6n+6) .Invoice-icon {\r\n  background: #f14f5a !important;\r\n}\r\n\r\n.legacy-analytics-layout {\r\n  display: none !important;\r\n}\r\n\r\n#analytics-yaxis-grid {\r\n  display: grid;\r\n  gap: 14px;\r\n  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\r\n}\r\n\r\n.analytics-grid-card {\r\n  background: #fff;\r\n  border: 1px solid #e5e7eb;\r\n  border-radius: 12px;\r\n  box-shadow: 0 1px 3px rgba(16, 24, 40, 0.08);\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 300px;\r\n}\r\n\r\n.analytics-grid-card.selected {\r\n  border-color: #43c45f;\r\n  box-shadow: 0 0 0 1px rgba(67, 196, 95, 0.25);\r\n}\r\n\r\n.analytics-grid-card-header {\r\n  align-items: center;\r\n  border-bottom: 1px solid #eef1f5;\r\n  display: flex;\r\n  gap: 8px;\r\n  justify-content: space-between;\r\n  padding: 10px 12px;\r\n}\r\n\r\n.analytics-grid-card-title {\r\n  color: #202939;\r\n  flex: 1 1 auto;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  margin: 0;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.analytics-grid-controls {\r\n  display: flex;\r\n  gap: 6px;\r\n  margin-left: 0;\r\n}\r\n\r\n.analytics-grid-controls .form-select {\r\n  border-color: #d6dce5;\r\n  border-radius: 8px;\r\n  font-size: 12px;\r\n  height: 30px;\r\n  line-height: 1;\r\n  min-width: 108px;\r\n  padding: 4px 28px 4px 8px;\r\n}\r\n\r\n.analytics-grid-card-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  flex: 1;\r\n  min-height: 220px;\r\n  padding: 10px;\r\n}\r\n\r\n.analytics-grid-chart {\r\n  background: #fcfdff;\r\n  border: 1px solid #edf0f4;\r\n  border-radius: 10px;\r\n  flex: 1 1 auto;\r\n  height: auto;\r\n  min-height: 220px;\r\n  overflow: hidden;\r\n  width: 100%;\r\n}\r\n\r\n.analytics-grid-message {\r\n  align-items: center;\r\n  color: #7d8798;\r\n  display: flex;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  height: 100%;\r\n  justify-content: center;\r\n  min-height: 220px;\r\n  text-align: center;\r\n}\r\n\r\n.analytics-grid-card.loading .analytics-grid-chart {\r\n  opacity: 0.65;\r\n}\r\n\r\n@media (max-width: 991px) {\r\n  #Analytics_Grid_Container {\r\n    padding-inline: 8px;\r\n  }\r\n\r\n  .analytics-hyperlink-panel {\r\n    padding: 8px;\r\n  }\r\n\r\n  .analytics-hyperlink-panel .analytics-container {\r\n    height: auto;\r\n    max-height: 360px;\r\n  }\r\n\r\n  #analytics-yaxis-grid {\r\n    gap: 10px;\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .analytics-grid-controls .form-select {\r\n    min-width: 95px;\r\n  }\r\n}\r\n\r\n/* Grid card interaction updates */\r\n.analytics-grid-card {\r\n  transition: box-shadow 0.2s ease, border-color 0.2s ease;\r\n}\r\n\r\n.analytics-grid-card.selected,\r\n.analytics-grid-card.active,\r\n.analytics-grid-card:hover,\r\n.analytics-grid-card.menu-open {\r\n  border-color: #4f8df8;\r\n  box-shadow: 0 8px 18px rgba(45, 104, 220, 0.22);\r\n}\r\n\r\n.analytics-grid-card-header {\r\n  position: relative;\r\n}\r\n\r\n.analytics-grid-menu-wrap {\r\n  align-items: center;\r\n  display: flex;\r\n  gap: 6px;\r\n  margin-left: 0;\r\n  position: relative;\r\n}\r\n\r\n.analytics-grid-popup-btn,\r\n.analytics-grid-menu-btn,\r\n.analytics-grid-resize-btn {\r\n  height: 28px !important;\r\n  opacity: 0;\r\n  pointer-events: none;\r\n  transition: opacity 0.18s ease;\r\n  visibility: hidden;\r\n  width: 28px !important;\r\n}\r\n\r\n.analytics-grid-card:hover .analytics-grid-popup-btn,\r\n.analytics-grid-card.active .analytics-grid-popup-btn,\r\n.analytics-grid-card.menu-open .analytics-grid-popup-btn,\r\n.analytics-grid-card:hover .analytics-grid-menu-btn,\r\n.analytics-grid-card.active .analytics-grid-menu-btn,\r\n.analytics-grid-card.menu-open .analytics-grid-menu-btn,\r\n.analytics-grid-card:hover .analytics-grid-resize-btn,\r\n.analytics-grid-card.active .analytics-grid-resize-btn,\r\n.analytics-grid-card.menu-open .analytics-grid-resize-btn,\r\n.analytics-grid-card.resizing .analytics-grid-resize-btn {\r\n  opacity: 1;\r\n  pointer-events: auto;\r\n  visibility: visible;\r\n}\r\n\r\n.analytics-grid-resize-btn {\r\n  cursor: ew-resize !important;\r\n}\r\n\r\n.analytics-grid-resize-btn .material-icons {\r\n  transform: rotate(90deg);\r\n}\r\n\r\n.analytics-grid-card.resizing {\r\n  border-color: #4f8df8;\r\n  box-shadow: 0 10px 22px rgba(45, 104, 220, 0.28);\r\n}\r\n\r\n.analytics-grid-menu-panel {\r\n  background: #fff;\r\n  border: 1px solid #d9e0ea;\r\n  border-radius: 10px;\r\n  box-shadow: 0 10px 30px rgba(14, 30, 62, 0.18);\r\n  display: none;\r\n  min-width: 190px;\r\n  padding: 10px;\r\n  position: absolute;\r\n  right: 0;\r\n  top: calc(100% + 6px);\r\n  z-index: 20;\r\n}\r\n\r\n.analytics-grid-card.menu-open .analytics-grid-menu-panel {\r\n  display: block;\r\n}\r\n\r\n.analytics-grid-menu-item + .analytics-grid-menu-item {\r\n  margin-top: 8px;\r\n}\r\n\r\n.analytics-grid-menu-label {\r\n  color: #516177;\r\n  display: block;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  margin-bottom: 3px;\r\n}\r\n\r\n.analytics-grid-menu-panel .form-select {\r\n  border-color: #d6dce5;\r\n  border-radius: 8px;\r\n  font-size: 12px;\r\n  height: 30px;\r\n  line-height: 1;\r\n  min-width: 100%;\r\n  padding: 4px 26px 4px 8px;\r\n}\r\n\r\n.analytics-grid-color-picker-wrap {\r\n  align-items: center;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.analytics-grid-color-picker-list {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.analytics-grid-color-input {\r\n  border: 1px solid #d6dce5;\r\n  border-radius: 50%;\r\n  cursor: pointer;\r\n  height: 22px;\r\n  padding: 0;\r\n  width: 22px;\r\n}\r\n\r\n.analytics-grid-color-input::-webkit-color-swatch-wrapper {\r\n  padding: 0;\r\n}\r\n\r\n.analytics-grid-color-input::-webkit-color-swatch {\r\n  border: none;\r\n  border-radius: 50%;\r\n}\r\n\r\n.analytics-grid-color-input::-moz-color-swatch {\r\n  border: none;\r\n  border-radius: 50%;\r\n}\r\n\r\n.analytics-grid-color-reset-btn {\r\n  font-size: 11px;\r\n  line-height: 1;\r\n  margin-left: auto;\r\n  min-height: 20px;\r\n  padding: 0 !important;\r\n}\r\n\r\n.analytics-grid-filter-action {\r\n  display: flex;\r\n  align-items: center;\r\n  border-top: 1px solid #edf0f4;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  margin-top: 2px;\r\n  min-height: 34px;\r\n  padding-top: 6px;\r\n}\r\n\r\n.analytics-grid-filter-count {\r\n  align-items: center;\r\n  color: #5b6b85;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  font-size: 11px;\r\n  gap: 4px;\r\n  font-weight: 600;\r\n}\r\n\r\n.analytics-grid-clear-filter-btn {\r\n  border-radius: 8px;\r\n  font-size: 11px;\r\n  padding: 2px 8px;\r\n}\r\n\r\n.analytics-grid-filter-chip {\r\n  background: rgba(43, 95, 217, 0.12);\r\n  border: 1px solid rgba(43, 95, 217, 0.25);\r\n  border-radius: 999px;\r\n  color: #2b5fd9;\r\n  display: inline-flex;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  line-height: 1;\r\n  padding: 2px 8px;\r\n}\r\n\r\n.analytics-grid-filter-more {\r\n  color: #5b6b85;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n}\r\n\r\n.analytics-grid-card.has-filter-selection .analytics-grid-card-title {\r\n  color: #2b5fd9;\r\n}\r\n\r\n#analytics-yaxis-grid .highcharts-contextbutton {\r\n  display: none !important;\r\n}\r\n\r\n.analytics-grid-popup-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  min-height: 100%;\r\n  padding: 14px;\r\n}\r\n\r\n.analytics-grid-popup-layout {\r\n  display: grid;\r\n  gap: 12px;\r\n  grid-template-columns: 7fr 3fr;\r\n  min-height: 420px;\r\n}\r\n\r\n.analytics-grid-popup-chart-wrap {\r\n  min-width: 0;\r\n}\r\n\r\n.analytics-grid-popup-panel {\r\n  background: #fff;\r\n  border: 1px solid #e1e7f0;\r\n  border-radius: 10px;\r\n  padding: 10px;\r\n  min-width: 0;\r\n}\r\n\r\n.analytics-grid-popup-panel-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.analytics-grid-popup-panel-title {\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #1f2a3d;\r\n}\r\n\r\n.analytics-grid-popup-panel-list {\r\n  max-height: 60vh;\r\n  overflow-y: auto;\r\n  margin: 0;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap {\r\n  margin-bottom: 8px;\r\n  padding: 0 2px;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-item {\r\n  align-items: center;\r\n  border-radius: 12px;\r\n  color: inherit;\r\n  display: flex;\r\n  padding: 8px 14px;\r\n  text-decoration: none;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-item:hover,\r\n.analytics-grid-popup-panel-list .Invoice-item:focus {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-icon {\r\n  align-items: center;\r\n  display: flex;\r\n  height: 34px;\r\n  justify-content: center;\r\n  line-height: 1;\r\n  width: 34px;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-icon .material-icons {\r\n  color: #fff !important;\r\n  font-size: 18px !important;\r\n  line-height: 1 !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content {\r\n  align-items: center;\r\n  display: flex;\r\n  flex: 1 0;\r\n  margin-left: 10px;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-item .subtitle {\r\n  color: var(--dark-text) !important;\r\n  flex: 1;\r\n  margin-bottom: 0;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-item .title {\r\n  color: #2f2a55;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  line-height: 30px;\r\n  margin-bottom: 0;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+1) .Invoice-item {\r\n  background: #fef5e6 !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+2) .Invoice-item {\r\n  background: #f4f9fe !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+3) .Invoice-item {\r\n  background: #fdf7fc !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+4) .Invoice-item {\r\n  background: #f4f9fe !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+5) .Invoice-item {\r\n  background: #e6fffb !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+6) .Invoice-item {\r\n  background: #f9f9f9 !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+1) .Invoice-icon {\r\n  background: #f4bc01 !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+2) .Invoice-icon {\r\n  background: #3d5996 !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+3) .Invoice-icon {\r\n  background: #e80502 !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+4) .Invoice-icon {\r\n  background: #539cfe !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+5) .Invoice-icon {\r\n  background: #3ddab4 !important;\r\n}\r\n\r\n.analytics-grid-popup-panel-list .Invoice-content-wrap:nth-child(6n+6) .Invoice-icon {\r\n  background: #f14f5a !important;\r\n}\r\n\r\n.analytics-grid-popup-title {\r\n  color: #1f2a3d;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  line-height: 1.35;\r\n}\r\n\r\n.analytics-grid-popup-chart {\r\n  background: #fff;\r\n  border: 1px solid #e1e7f0;\r\n  border-radius: 10px;\r\n  min-height: 360px;\r\n  padding: 8px;\r\n}\r\n\r\n/* In popup bar/column charts, hide dense in-bar labels and keep values in tooltip */\r\n.analytics-grid-popup-chart.analytics-grid-popup-hide-data-labels .highcharts-data-labels,\r\n.analytics-grid-popup-chart.analytics-grid-popup-hide-data-labels .highcharts-data-label,\r\n.analytics-grid-popup-chart.analytics-grid-popup-hide-data-labels .highcharts-data-label text {\r\n  display: none !important;\r\n}\r\n\r\n.analytics-hyperlink-item.selected-value {\r\n  border: 1px solid #4f8df8;\r\n  box-shadow: 0 8px 18px rgba(45, 104, 220, 0.18);\r\n}\r\n\r\n.analytics-hyperlink-item.selected-value .subtitle {\r\n  color: #2b5fd9;\r\n}\r\n\r\n@media (max-width: 991px) {\r\n  .analytics-grid-popup-btn,\r\n  .analytics-grid-menu-btn {\r\n    opacity: 1;\r\n    pointer-events: auto;\r\n    visibility: visible;\r\n  }\r\n\r\n  .analytics-grid-menu-panel {\r\n    min-width: 180px;\r\n  }\r\n\r\n  .analytics-grid-popup-layout {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .analytics-grid-popup-panel-list {\r\n    max-height: 45vh;\r\n  }\r\n}\r\n\r\n/* SmartView numeric columns */\r\n#table-body_Container .table > thead th.sv-num-header,\r\n#table-body_Container .table > tbody td.sv-num-cell,\r\n#table-body_Container .sv-group-detail thead th.sv-num-header,\r\n#table-body_Container .sv-group-detail tbody td.sv-num-cell {\r\n  text-align: right;\r\n}\r\n\r\n/* SmartView static KPI + chart strip */\r\n.smartview-table-page {\r\n  background-color: #f5f6fa;\r\n  font-family: 'urbanist', sans-serif;\r\n}\r\n\r\n.smartview-table-page .card-header.Page-title {\r\n  display: flex;\r\n  align-items: center;\r\n  border-radius: 0;\r\n}\r\n\r\n#table-body_Container .table > thead th,\r\n#table-body_Container .table > thead th span {\r\n  font-size: 14px;\r\n  font-weight: bolder !important;\r\n  white-space: nowrap;\r\n}\r\n\r\n#table-body_Container .table > tbody td {\r\n 