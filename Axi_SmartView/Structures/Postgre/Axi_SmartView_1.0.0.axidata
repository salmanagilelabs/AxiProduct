            "dc3": {
              "row1": {
                "filename": "axi_smartltcss",
                "filetype": "Css",
                "css_js_src": "/*https://web.agile-labs.com/minZIP/*//*version=3.9.1*/ :root {   --dark-text:#333;   --white-text:#fff;   --grey-text:#aeaeae;   --dark-bg:#191c24;   --dark-bg-1:#000000;   --white-bg:#fff;   --grey-bg:#F3F3F3;   --gradient-bg:linear-gradient(91deg,#fad1c8,#d1e2fb,#fde8cd,#e6fffb);   --gradient-bg-1:linear-gradient(333deg, #6eade2, #ee87a4, #5071a4, #4bca82);   --white-light-bg:#ffffff85 }    .btn {   display: flex;   align-items: center;    gap: 5px; }  .chart-icon {   font-size: 1.25rem; }  .chart-name {   font-size: 1rem; }   .btn-group:hover .dropdown-menu {   display: block !important; }   .dropdown-menu {   display: none;   position: absolute;   z-index: 1000; }    .dropdown-menu > li > a {   display: flex;   align-items: center;  }     .scroll-container {   display: flex;   align-items: center;   position: relative; }  .scrollable-menu {   overflow-x: auto;   white-space: nowrap;   scrollbar-width: none;    flex: 1;    /* padding: 10px 0; */ }  .scrollable-menu::-webkit-scrollbar {   display: none;  }  #dv_EntityContainer {   display: flex;   gap: 10px; }  #dv_EntityContainer li {   padding: 10px 15px;   background-color: #f2f2f2;   border-radius: 16px;   cursor: pointer;   font-size: 14px;   color: #333;   white-space: nowrap; }  .scroll-btn {   font-size: 24px;   cursor: pointer;   color: #333;   padding: 5px;   display: flex;   align-items: center;   justify-content: center;   width: 30px;   height: 30px;   /* position: absolute;   background: #f9f9f9;    z-index: 1; */   border-radius: 50%; }  .left-btn {   left: 5px; }  .right-btn {   right: 5px; }  .scroll-btn:hover {   background-color: #e0e0e0; /* Highlight on hover */ }  .highcharts-label span { \tfont-size: 16px !important; \tfont-family: urbanist !important; \tfont-weight: 700 !important; \tline-height: 22px !important; }   #chart-title{ font-family: 'Urbanist', 'Nunito Sans', 'Roboto', sans-serif !important; font-size: 18px  } .highcharts-label text { \tfont-size: 14px !important; \tfont-weight: 600 !important; \tfont-family: urbanist; }  #chart-container { width: 800px; /* Set desired width */ height: 500px; /* Set desired height */ }  #dvModalFilter .row {   margin-bottom: 15px; } .form-group.form-row.fldCaption label {   position: absolute;   top: -8px;   left: 9px;   background: #fff;   padding: 0 8px; }  .form-group.form-row.fldCaption {   display: flex;   position: relative; }   .select2-container .select2-selection--multiple {   padding-right: 24px;    position: relative; }   .select2-container .select2-selection--multiple:after {   content: \">\";   font-size: 16px;    color: #888;    position: absolute;   right: 10px;   top: 50%;   transform: translateY(-50%) rotate(90deg);    pointer-events: none;    transition: transform 0.3s ease;  }   .select2-container--open .select2-selection--multiple:after {   transform: translateY(-50%) rotate(180deg);  }   /* .form-group.form-row.fldCaption .col:last-child {   padding-right: 0 !important; } */ .form-group.form-row.fldCaption .col {   padding-inline: 5px;   position: relative;   padding-left: 0; }  .modal-dialog-scrollable .modal-body {   overflow-y: auto; }     .col-md-3.fldCaption {   display: flex;   align-items: center; } .col-md-3.fldCaption p {   margin-bottom: 0 !important; }   .modal-body {   word-wrap: break-word; }  .direction-btns{     display: inline;     float: right; } .card-footer-bottom {   opacity:1 !important;   visibility:visible !important;   transition:opacity .6s ease-in-out } .card-footer-bottom.show {     opacity: 1;     visibility: visible;  }   .scroller{     overflow-y: scroll!important; } .Aggregation-content.subtitle {     color: #555;     white-space: nowrap;     overflow: hidden;     text-overflow: ellipsis!important;     max-width: 150px;    }    .scroll-bar{     overflow-y: scroll!important;   }  #dv_EntityContainer {     display: flex;     flex-wrap: nowrap; /* Prevent items from wrapping to the next line */     overflow-x: auto;     white-space: nowrap;     width: max-content; /* Ensure the width of the container expands with its content */ }  #dv_EntityContainer li {     display: inline-block;     margin-right: 0px; /* Adjust the spacing between items */ }    .selected-entities-container {     list-style-type: none; /* Removes the bullet markers */     padding: 0; /* Removes any default padding */     margin: 0; /* Removes any default margin */ } .pending-name {   font-weight:700;   font-size:20px } .selected-name {   font-weight:700;   font-size:20px } .tick-icon {     color: #1bac1b;     font-size: 18px;     border-radius: 50%;     width: 24px;     height: 24px;     display: flex;     justify-content: center;     align-items: center;     margin-left: 5px; }  .selected-entities-container {     display: flex;     flex-wrap: wrap;     gap: 10px; /* Adjust spacing between selected items */ }  .selected-item {          border: 1px solid #cccccc6e;     border-radius: 7px;     padding: 15px;     text-align: center;     min-height: 115px;     position: relative;      }  .selected-item.active {     /* Add active styling here */     background-color: #f0f0f0; }   .Aggregation-item:hover, .Aggregation-item.dragging {     transition: border 0.3s ease!important;      border: 1px solid green!important; }  .Aggregation-Item-wrap.over {      border: 1px solid green!important;      transition: border 0.3s ease!important; /* Ensure the transition is applied to these states as well */  }   .Data-Group_Items:hover {     /* border: 1px solid green!important; */      opacity: 1; /* Ensure the opacity is set to full */     transition: border 0.3s ease!important; /* Ensure the transition is applied to these states as well */   }  .Data-Group_Items.dragging{     border: 1px solid green!important;      opacity: 1; /* Ensure the opacity is set to full */         transition: border 0.3s ease!important; /* Ensure the transition is applied to these states as well */    }   .nav-item {     cursor: grab; }   .nav-item.hover {     