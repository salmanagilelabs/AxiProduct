            "dc2": {
              "row1": {
                "html_editor_htmlsrc": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Document</title>\r\n        <link rel=\"stylesheet\" href=\"../../../UI/axpertUI/style.bundle.css\" />\r\n    <link rel=\"stylesheet\" href=\"../../../UI/axpertUI/plugins.bundle.css\" />\r\n    <link rel=\"stylesheet\" href=\"../../../ThirdParty/jquery-confirm-master/jquery-confirm.min.css\" />\r\n    <link href=\"../../../Css/datatables.min.css\" rel=\"stylesheet\" />\r\n    <link rel=\"stylesheet\" href=\"../../../Css/Entity.css\" />\r\n\r\n    <link rel=\"stylesheet\" href=\"css/analytics.css?v=2\" />\r\n   <style>\r\n         .row-arrow {\r\n  cursor: pointer;\r\n  font-size: 18px;\r\n  margin-left: 6px;\r\n  vertical-align: middle;\r\n  color: #666;\r\n}\r\n\r\n.row-arrow:hover {\r\n  color: #000;\r\n}\r\n    </style>\r\n    \r\n \r\n</head>\r\n<body class=\"smartview-table-page\">\r\n\r\n                          \r\n   \r\n <div class=\"card-header Page-title\" style=\" width: 100%;   justify-content: space-between;display: flex;\" >\r\n                                    <!--begin::Title-->\r\n                                    <h3 class=\"card-title align-items-start flex-column\" style=\"margin-bottom: 0px !important;\">\r\n                                        <span class=\"card-label fw-bold text-gray-900\" id=\"EntityTitle\"></span>\r\n                                    </h3>\r\n                                    \r\n                                    <!--end::Title-->\r\n        \r\n        \r\n                                    <!--begin::Toolbar-->\r\n        \r\n       \r\n                                   \r\n                                </div>\r\n    \r\n    <div id=\"Analytics-Top\" class=\"card-body\">\r\n         \r\n<!--        <button title=\"View More\" id=\"KPItoggleBtn\" class=\"toggle-btn\"> ↓</button>-->\r\n    \r\n                                <div id=\"KPIcardWrapper\" class=\"Sales-data-content-wrapper\" data-sv-has-data=\"false\" data-sv-user-visible=\"true\" style=\"display:none;\">\r\n                                    <!-- KPI cards render dynamically -->\r\n                                  \r\n                                </div>    \r\n        \r\n      \r\n        \r\n        \r\n<!--         <button  title=\"View More\" id=\"ChartstoggleBtn\" class=\"toggle-btn\"> ↓</button>-->\r\n\r\n                                <div id=\"ChartscardWrapper\" class=\"Sales-data-charts-wrapper\" data-sv-has-data=\"false\" data-sv-user-visible=\"true\" style=\"display:none;\">\r\n                                    <!-- Chart cards render dynamically -->\r\n                               \r\n                                </div>\r\n        \r\n         <div class=\"table-body\" id=\"table-body_Container\">\r\n        <!-- Table view content will be populated dynamically -->\r\n    </div>\r\n            \r\n       \r\n    \r\n        \r\n    </div>\r\n    \r\n    \r\n    <div id=\"Analytics-Footer\" class=\"card-footer\">\r\n    \r\n    \r\n    \r\n    \r\n        <div class=\"Tab-Toolbar-Sec\">\r\n     <ul class=\"nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold\">\r\n                            <!--begin::Nav item-->\r\n                <li class=\"nav-item mt-2\">\r\n                    <a class=\"nav-link text-active-primary ms-0 me-10 py-5 active\" href=\"\">\r\n                        Default<span>View       </span>             </a>\r\n                </li>\r\n                <!--end::Nav item-->\r\n                            \r\n           \r\n                    </ul>\r\n            \r\n            <div class=\"Filter-Column-New\">\r\n            <div class=\"Filter-Caption\">\r\n              \r\n                 <button type=\"button\"\r\n                                                class=\"btn btn-sm btn-white btn-active-primary btn-custom-border-radius d-flex align-items-center gap-1\"\r\n                                                id=\"smartviewFilterToolbarBtn\"\r\n                                                aria-haspopup=\"dialog\"\r\n                                                aria-expanded=\"false\"\r\n                                                aria-controls=\"smartviewInlineFilterPanel\"\r\n                                                onclick=\"openFilters(); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"Filter\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">filter_alt</span>\r\n                                                <span>Click here to Filter Data</span>\r\n                     <span class=\"filter-btn-caption\">Filter</span>\r\n                                            </button>\r\n                </div>\r\n                \r\n              <div class=\"filterPills flex-row py-2 px-2 gap-3\" style=\"display: none;\">\r\n                                    <button\r\n                                        class=\"filterGroupBadge badge rounded-pill bg-primary d-flex align-items-center gap-2 py-2 px-6 border-0\"\r\n                                        style=\"max-width: fit-content;\" data-toggle=\"tooltip\" data-placement=\"top\"\r\n                                        data-html=\"true\">\r\n                                        All\r\n                                    </button>\r\n                                </div>\r\n            </div>\r\n            \r\n           \r\n            \r\n             <div class=\"card-toolbar\">\r\n                                        <div class=\"Tkts-toolbar-Right d-flex flex-row align-items-center gap-2\">\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-sm btn-primary btn-custom-border-radius\"\r\n                                                id=\"submitSmartviewButton\"\r\n                                                onclick=\"submitSmartviewToolbar(); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"Submit\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">save</span>\r\n                                            </button>\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-sm btn-icon btn-white btn-active-primary btn-custom-border-radius\"\r\n                                                id=\"smartviewNewTstructBtn\"\r\n                                                onclick=\"smartviewOpenNewTstruct(this); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"New\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">add</span>\r\n                                            </button>\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-sm btn-icon btn-white btn-active-primary btn-custom-border-radius\"\r\n                                                id=\"smartviewPageRefreshBtn\"\r\n                                                onclick=\"smartviewReloadFrame(); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"Refresh\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">refresh</span>\r\n                                            </button>\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-sm btn-white btn-active-primary btn-custom-border-radius d-flex align-items-center gap-1\"\r\n                                                id=\"smartviewDownloadTemplateBtn\"\r\n                                                onclick=\"smartviewOpenExcelTemplateMenu(this); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"Download Template\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">download</span>\r\n                                                <span>Template</span>\r\n                                            </button>\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-sm btn-white btn-active-primary btn-custom-border-radius d-flex align-items-center gap-1\"\r\n                                                id=\"smartviewUploadExcelBtn\"\r\n                                                onclick=\"triggerSmartviewUploadExcel(); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"Upload Excel\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">upload_file</span>\r\n                                                <span>Upload</span>\r\n                                            </button>\r\n                                            <input type=\"file\" id=\"smartviewUploadExcelInput\" accept=\".xlsx,.xls\" hidden>\r\n                                            <!-- Searchbar button -->\r\n                                            <fieldset class=\"searchFieldset d-flex gap-2\">\r\n                                                <input type=\"search\" id=\"searchBox\" title=\"searchbar\" autocomplete=\"false\" />\r\n                                                <button type=\"button\" class=\"btn btn-sm btn-icon btn-white btn-active-primary btn-custom-border-radius\"\r\n                                                    id=\"searchBoxButton\" onclick=\"searchInput.classList.toggle('show');\" data-bs-toggle=\"tooltip\"\r\n                                                    title=\"Search\">\r\n                                                    <span class=\"material-icons material-icons-style material-icons-2\">search</span>\r\n                                                </button>\r\n                                            </fieldset>\r\n                                           \r\n\r\n                                            <!-- <button type=\"button\" class=\"btn btn-sm btn-icon btn-primary btn-active-primary btn-custom-border-radius\"\r\n                                                onclick=\"_entity.openNewTstruct(); return false;\" data-toggle=\"tooltip\" id=\"add-entity\" title=\"New\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">add</span>\r\n                                            </button> -->\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-icon btn-white btn-color-gray-600 btn-active-primary shadow-sm tb-btn btn-sm d-none\"\r\n                                                onclick=\"return false;\" data-toggle=\"tooltip\" title=\"Delete\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">remove</span>\r\n                                            </button>\r\n\r\n                                            <!-- New Delete Button -->\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-icon btn-white btn-color-gray-600 btn-active-primary shadow-sm tb-btn btn-sm\"\r\n                                                id=\"deleteSelectedButton\"\r\n                                                onclick=\"deleteSelectedRecordsFromToolbar(); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"Delete\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">delete</span>\r\n                                            </button>\r\n\r\n                                            <div style=\"float: right; padding-left: 3px;\">\r\n                                                <button type=\"button\" data-toggle=\"tooltip\" title=\"Options\"\r\n                                                    class=\"btn btn-white btn-color-gray-600 btn-active-primary shadow-sm tb-btn btn-sm d-flex align-items-center gap-1\"\r\n                                                    data-kt-menu-trigger=\"{default:'click', lg: 'click'}\" data-kt-menu-attach=\"parent\"\r\n                                                    data-kt-menu-placement=\"bottom-end\">\r\n                                                    <span class=\"material-icons material-icons-style material-icons-2\">more_vert</span>\r\n                                                    <span>Options</span>\r\n                                                </button>\r\n\r\n                                                <div id=\"smartviewOptionsMenu\" class=\"menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-title-gray-700 menu-icon-gray-500 menu-active-bg menu-state-color fw-semibold py-4 fs-base w-200px\" data-kt-menu=\"true\">\r\n                                                    <div class=\"menu-item px-3 my-0\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"openFieldSelection(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">view_column</span>\r\n                                                            <span class=\"menu-title\">Columns</span>\r\n                                                        </a>\r\n                                                    </div>\r\n\r\n                                                    <div class=\"menu-item px-3 my-0\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"openSmartviewGroupOption(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">segment</span>\r\n                                                            <span class=\"menu-title\">Group</span>\r\n                                                        </a>\r\n                                                    </div>\r\n\r\n                                                    <div class=\"menu-item px-3 my-0\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"smartviewSaveCurrentView(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">bookmark</span>\r\n                                                            <span class=\"menu-title\" id=\"smartviewOptionSaveViewLabel\">Save view</span>\r\n                                                        </a>\r\n                                                    </div>\r\n\r\n                                                    <div class=\"menu-item px-3 my-0\" id=\"smartviewOptionSaveAsViewItem\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"smartviewSaveCurrentViewAsNew(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">bookmark_add</span>\r\n                                                            <span class=\"menu-title\" id=\"smartviewOptionSaveAsViewLabel\">Save as new view</span>\r\n                                                        </a>\r\n                                                    </div>\r\n\r\n                                                    <div class=\"menu-item px-3 my-0\" id=\"smartviewOptionRemoveViewItem\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"smartviewRemoveSelectedView(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">delete_outline</span>\r\n                                                            <span class=\"menu-title\">Remove view</span>\r\n                                                        </a>\r\n                                                    </div>\r\n\r\n                                                    <div class=\"menu-item px-3 my-0\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"toggleSmartviewKpiVisibility(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">view_agenda</span>\r\n                                                            <span class=\"menu-title\" id=\"smartviewOptionToggleKpiLabel\">Hide KPI</span>\r\n                                                        </a>\r\n                                                    </div>\r\n\r\n                                                    <div class=\"menu-item px-3 my-0\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"toggleSmartviewChartsVisibility(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">insights</span>\r\n                                                            <span class=\"menu-title\" id=\"smartviewOptionToggleChartsLabel\">Hide charts</span>\r\n                                                        </a>\r\n                                                    </div>\r\n\r\n                                                    <div class=\"menu-item px-3 my-0\">\r\n                                                        <a href=\"#\" class=\"menu-link px-3 py-2\" onclick=\"openSmartviewConfigureTstruct(); return false;\">\r\n                                                            <span class=\"material-icons material-icons-style material-icons-2\">settings</span>\r\n                                                            <span class=\"menu-title\">Configure</span>\r\n                                                        </a>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                      \r\n\r\n                                        </div>\r\n                                        \r\n                                    </div>\r\n            \r\n            </div>\r\n    \r\n    \r\n        \r\n        </div>\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n                                <div class=\"modal fade\" id=\"fieldsModal\">\r\n                                    <div class=\"modal-dialog modal-md modal-dialog-scrollable\">\r\n                                        <div class=\"modal-content\">\r\n                                            <div class=\"modal-header\" style=\"padding: 1.75rem !important\">\r\n                                                <h4 class=\"modal-title\">Fields Selection</h4>\r\n                                                <button type=\"button\" title=\"Close\" class=\"btn btn-icon btn-danger btn-active-primary shadow-sm tb-btn btn-sm\" onclick=\"fieldsModelClose()\">\r\n                                                    <span class=\"material-icons material-icons-style material-icons-2\">close</span>\r\n                                                </button>\r\n                                            </div>\r\n                                            <div class=\"modal-body\" style=\"max-height: 65vh\">\r\n                                                <div class=\"container\" id=\"dvModalFields\">\r\n                                                    <div class=\"container-fluid\">\r\n                                                        <div class=\"table-responsive\">\r\n                                                            <table class=\"table table-hover\">\r\n                                                                <thead class=\"thead-dark\">\r\n                                                                    <tr>\r\n                                                                        <th><input type=\"checkbox\" id=\"check-all\"></th>\r\n                                                                        <th>Field Name</th>\r\n                                                                    </tr>\r\n                                                                </thead>\r\n                                                            </table>\r\n                                                        </div>\r\n                                                        <div class=\"table-responsive\" id=\"fields-selection\"></div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div class=\"modal-footer\">\r\n                                                <div class=\"d-flex align-items-end gap-3 flex-wrap w-100 justify-content-between\">\r\n                                                    <div style=\"min-width: 340px;\">\r\n                                                        <label for=\"selectField\" class=\"form-label mb-1\">Select Key Field:</label>\r\n                                                        <select id=\"selectField\" class=\"form-select form-select-sm\">\r\n                                                            <option value=\"\">--Select--</option>\r\n                                                        </select>\r\n                                                    </div>\r\n                                                    <div>\r\n                                                    <button type=\"button\" onclick=\"resetFields()\" class=\"btn btn-white btn-sm\">Reset</button>\r\n                                                    <button type=\"button\" onclick=\"applyFields()\" class=\"btn btn-primary btn-sm\">Apply</button>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n\r\n                                <!-- Inline Filters (replaces modal popup) -->\r\n                                <div id=\"smartviewInlineFilterPanel\" class=\"px-2 py-2 sv-inline-filter-panel\" style=\"display: none;\" aria-hidden=\"true\">\r\n                                    <div class=\"card shadow-sm\">\r\n                                        <div class=\"card-header py-2 d-flex align-items-center justify-content-between\">\r\n                                            <h5 class=\"m-0 fw-bold\">Filters</h5>\r\n                                            <button type=\"button\"\r\n                                                class=\"btn btn-sm btn-icon btn-white btn-active-primary btn-custom-border-radius\"\r\n                                                onclick=\"openFilters(); return false;\"\r\n                                                data-toggle=\"tooltip\" title=\"Collapse\">\r\n                                                <span class=\"material-icons material-icons-style material-icons-2\">expand_less</span>\r\n                                            </button>\r\n                                        </div>\r\n                                        <div class=\"card-body py-3\">\r\n                                            <!-- Entity-Filter.js dynamically injects filter rows here -->\r\n                                            <div id=\"dvModalFilter\" class=\"row g-3\"></div>\r\n                                        </div>\r\n                                        <div class=\"card-footer py-2 d-flex justify-content-end gap-2\">\r\n                                            <button type=\"button\" id=\"clearFilterBtn\" class=\"btn btn-outline-secondary btn-sm\">Clear</button>\r\n                                            <button type=\"button\" id=\"applyFilterButton\" class=\"btn btn-primary btn-sm\">Apply</button>\r\n                                        </div>\r\n                                        <!-- Hidden compatibility controls for Entity-Filter internals -->\r\n                                        <div class=\"d-none\" aria-hidden=\"true\">\r\n                                            <input class=\"form-check-input\" type=\"checkbox\" id=\"filterGroupCheckbox\" style=\"display:none;\">\r\n                                            <input type=\"text\" id=\"filterGroupName\" class=\"form-control form-control-sm\" style=\"display:none;\" disabled>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n\r\n                               \r\n                                \r\n   \r\n    <div id=\"noMoreRecordsMessage\" class=\"no-more-records-message\"\r\n        style=\"display: none\">\r\n        No more records\r\n    </div> \r\n</body>\r\n  <script type=\"text/javascript\" src=\"../../../UI/axpertUI/plugins.bundle.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../../../UI/axpertUI/scripts.bundle.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../../../ThirdParty/jquery-confirm-master/jquery-confirm.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../../../Js/common.min.js?v=158\"></script>\r\n    <script type=\"text/javascript\" src=\"../../../Js/alerts.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../../../Js/xmlToJson.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../../../Js/handlebars.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../../../ThirdParty/DataTables-1.10.13/extensions/Extras/moment.min.js\"></script>\r\n\r\n    <script src=\"../../../js/datatables.js\"></script>\r\n    <script src=\"../../../js/Entity-Filter.js\"></script>\r\n    <script src=\"../../../Js/Entity-Common.js\"></script>\r\n    <script src=\"../../../Js/AxInterface.js\"></script>\r\n    <script src=\"../../../Js/xlsx.full.min.js\"></script>\r\n    <script src=\"../../../ThirdParty/Highcharts/highcharts.js\"></script>\r\n    <script src=\"../../../ThirdParty/Highcharts/highcharts-3d.js\"></script>\r\n    <script src=\"../../../ThirdParty/Highcharts/highcharts-more.js\"></script>\r\n    <script src=\"../../../ThirdParty/Highcharts/highcharts-exporting.js\"></script>\r\n    <script type=\"text/javascript\" src=\"js/smartview.js?v=3\"></script>\r\n    \r\n    <script>\r\nfunction setupToggle(buttonId, wrapperId) {\r\n\r\n    const btn = document.getElementById(buttonId);\r\n    const wrapper = document.getElementById(wrapperId);\r\n    if (!btn || !wrapper) return;\r\n\r\n    btn.addEventListener(\"click\", () => {\r\n\r\n        const expanded = wrapper.classList.toggle(\"expanded\");\r\n\r\n        btn.innerHTML = expanded\r\n//            ? \"View Less ↑\"\r\n//            : \"View More ↓\";\r\n         ? \"  ↑\"\r\n            : \"  ↓\";\r\n\r\n    });\r\n}\r\n\r\n/* Initialize */\r\nsetupToggle(\"KPItoggleBtn\", \"KPIcardWrapper\");\r\nsetupToggle(\"ChartstoggleBtn\", \"ChartscardWrapper\");\r\n            \r\n</script>\r\n    \r\n    \r\n\r\n\r\n    \r\n\r\n    <script>\r\n    document.querySelectorAll(\".carousel-wrapper\").forEach(wrapper => {\r\n\r\n  const carousel = wrapper.querySelector(\".Carousel-Items-Container\");\r\n  const leftBtn = wrapper.querySelector(\".btn-left\");\r\n  const rightBtn = wrapper.querySelector(\".btn-right\");\r\n\r\n  function updateArrows() {\r\n    const scrollLeft = carousel.scrollLeft;\r\n    const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;\r\n\r\n    // Left button\r\n    leftBtn.style.display = scrollLeft <= 0 ? \"none\" : \"flex\";\r\n\r\n    // Right button\r\n    rightBtn.style.display =\r\n      scrollLeft >= maxScrollLeft - 1 ? \"none\" : \"flex\";\r\n  }\r\n\r\n  // Scroll left\r\n  leftBtn.addEventListener(\"click\", () => {\r\n    carousel.scrollBy({\r\n      left: -320,\r\n      behavior: \"smooth\"\r\n    });\r\n  });\r\n\r\n  // Scroll right\r\n  rightBtn.addEventListener(\"click\", () => {\r\n    carousel.scrollBy({\r\n      left: 320,\r\n      behavior: \"smooth\"\r\n    });\r\n  });\r\n\r\n  // Events\r\n  carousel.addEventListener(\"scroll\", updateArrows);\r\n  window.addEventListener(\"resize\", updateArrows);\r\n\r\n  // Initial check\r\n  updateArrows();\r\n});\r\n    </script>\r\n\r\n"
              }
            },
            "dc3": {
