                "filename": "axi_smartltcss",
                "filetype": "Css",
                "css_js_src": "/*https://web.agile-labs.com/minZIP/*//*version=3.9.1*/\r\n:root {\r\n  --dark-text:#333;\r\n  --white-text:#fff;\r\n  --grey-text:#aeaeae;\r\n  --dark-bg:#191c24;\r\n  --dark-bg-1:#000000;\r\n  --white-bg:#fff;\r\n  --grey-bg:#F3F3F3;\r\n  --gradient-bg:linear-gradient(91deg,#fad1c8,#d1e2fb,#fde8cd,#e6fffb);\r\n  --gradient-bg-1:linear-gradient(333deg, #6eade2, #ee87a4, #5071a4, #4bca82);\r\n  --white-light-bg:#ffffff85\r\n}\r\n\r\n\r\n\r\n.btn {\r\n  display: flex;\r\n  align-items: center; \r\n  gap: 5px;\r\n}\r\n\r\n.chart-icon {\r\n  font-size: 1.25rem;\r\n}\r\n\r\n.chart-name {\r\n  font-size: 1rem;\r\n}\r\n\r\n\r\n.btn-group:hover .dropdown-menu {\r\n  display: block !important;\r\n}\r\n\r\n\r\n.dropdown-menu {\r\n  display: none;\r\n  position: absolute;\r\n  z-index: 1000;\r\n}\r\n\r\n\r\n\r\n.dropdown-menu > li > a {\r\n  display: flex;\r\n  align-items: center; \r\n}\r\n\r\n\r\n\r\n\r\n.scroll-container {\r\n  display: flex;\r\n  align-items: center;\r\n  position: relative;\r\n}\r\n\r\n.scrollable-menu {\r\n  overflow-x: auto;\r\n  white-space: nowrap;\r\n  scrollbar-width: none; \r\n  flex: 1; \r\n  /* padding: 10px 0; */\r\n}\r\n\r\n.scrollable-menu::-webkit-scrollbar {\r\n  display: none; \r\n}\r\n\r\n#dv_EntityContainer {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n#dv_EntityContainer li {\r\n  padding: 10px 15px;\r\n  background-color: #f2f2f2;\r\n  border-radius: 16px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n  color: #333;\r\n  white-space: nowrap;\r\n}\r\n\r\n.scroll-btn {\r\n  font-size: 24px;\r\n  cursor: pointer;\r\n  color: #333;\r\n  padding: 5px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 30px;\r\n  height: 30px;\r\n  /* position: absolute;\r\n  background: #f9f9f9; \r\n  z-index: 1; */\r\n  border-radius: 50%;\r\n}\r\n\r\n.left-btn {\r\n  left: 5px;\r\n}\r\n\r\n.right-btn {\r\n  right: 5px;\r\n}\r\n\r\n.scroll-btn:hover {\r\n  background-color: #e0e0e0; /* Highlight on hover */\r\n}\r\n\r\n.highcharts-label span {\r\n\tfont-size: 16px !important;\r\n\tfont-family: urbanist !important;\r\n\tfont-weight: 700 !important;\r\n\tline-height: 22px !important;\r\n}\r\n\r\n\r\n#chart-title{\r\nfont-family: 'Urbanist', 'Nunito Sans', 'Roboto', sans-serif !important;\r\nfont-size: 18px\r\n\r\n}\r\n.highcharts-label text {\r\n\tfont-size: 14px !important;\r\n\tfont-weight: 600 !important;\r\n\tfont-family: urbanist;\r\n}\r\n\r\n#chart-container {\r\nwidth: 800px; /* Set desired width */\r\nheight: 500px; /* Set desired height */\r\n}\r\n\r\n#dvModalFilter .row {\r\n  margin-bottom: 15px;\r\n}\r\n.form-group.form-row.fldCaption label {\r\n  position: absolute;\r\n  top: -8px;\r\n  left: 9px;\r\n  background: #fff;\r\n  padding: 0 8px;\r\n}\r\n\r\n.form-group.form-row.fldCaption {\r\n  display: flex;\r\n  position: relative;\r\n}\r\n\r\n\r\n.select2-container .select2-selection--multiple {\r\n  padding-right: 24px; \r\n  position: relative;\r\n}\r\n\r\n\r\n.select2-container .select2-selection--multiple:after {\r\n  content: \">\";\r\n  font-size: 16px; \r\n  color: #888; \r\n  position: absolute;\r\n  right: 10px;\r\n  top: 50%;\r\n  transform: translateY(-50%) rotate(90deg); \r\n  pointer-events: none; \r\n  transition: transform 0.3s ease; \r\n}\r\n\r\n\r\n.select2-container--open .select2-selection--multiple:after {\r\n  transform: translateY(-50%) rotate(180deg); \r\n}\r\n\r\n\r\n/* .form-group.form-row.fldCaption .col:last-child {\r\n  padding-right: 0 !important;\r\n} */\r\n.form-group.form-row.fldCaption .col {\r\n  padding-inline: 5px;\r\n  position: relative;\r\n  padding-left: 0;\r\n}\r\n\r\n.modal-dialog-scrollable .modal-body {\r\n  overflow-y: auto;\r\n}   \r\n\r\n.col-md-3.fldCaption {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n.col-md-3.fldCaption p {\r\n  margin-bottom: 0 !important;\r\n}\r\n\r\n\r\n.modal-body {\r\n  word-wrap: break-word;\r\n}\r\n\r\n.direction-btns{\r\n    display: inline;\r\n    float: right;\r\n}\r\n.card-footer-bottom {\r\n  opacity:1 !important;\r\n  visibility:visible !important;\r\n  transition:opacity .6s ease-in-out\r\n}\r\n.card-footer-bottom.show {\r\n    opacity: 1;\r\n    visibility: visible; \r\n}\r\n\r\n\r\n.scroller{\r\n    overflow-y: scroll!important;\r\n}\r\n.Aggregation-content.subtitle {\r\n    color: #555;\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis!important;\r\n    max-width: 150px; \r\n  }\r\n\r\n  .scroll-bar{\r\n    overflow-y: scroll!important;\r\n  }\r\n\r\n#dv_EntityContainer {\r\n    display: flex;\r\n    flex-wrap: nowrap; /* Prevent items from wrapping to the next line */\r\n    overflow-x: auto;\r\n    white-space: nowrap;\r\n    width: max-content; /* Ensure the width of the container expands with its content */\r\n}\r\n\r\n#dv_EntityContainer li {\r\n    display: inline-block;\r\n    margin-right: 0px; /* Adjust the spacing between items */\r\n}\r\n\r\n\r\n\r\n.selected-entities-container {\r\n    list-style-type: none; /* Removes the bullet markers */\r\n    padding: 0; /* Removes any default padding */\r\n    margin: 0; /* Removes any default margin */\r\n}\r\n.pending-name {\r\n  font-weight:700;\r\n  font-size:20px\r\n}\r\n.selected-name {\r\n  font-weight:700;\r\n  font-size:20px\r\n}\r\n.tick-icon {\r\n    color: #1bac1b;\r\n    font-size: 18px;\r\n    border-radius: 50%;\r\n    width: 24px;\r\n    height: 24px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-left: 5px;\r\n}\r\n\r\n.selected-entities-container {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px; /* Adjust spacing between selected items */\r\n}\r\n\r\n.selected-item {\r\n    \r\n    border: 1px solid #cccccc6e;\r\n    border-radius: 7px;\r\n    padding: 15px;\r\n    text-align: center;\r\n    min-height: 115px;\r\n    position: relative;\r\n    \r\n}\r\n\r\n.selected-item.active {\r\n    /* Add active styling here */\r\n    background-color: #f0f0f0;\r\n}\r\n\r\n\r\n.Aggregation-item:hover, .Aggregation-item.dragging {\r\n    transition: border 0.3s ease!important;\r\n\r\n    border: 1px solid green!important;\r\n}\r\n\r\n.Aggregation-Item-wrap.over {\r\n\r\n    border: 1px solid green!important;\r\n\r\n    transition: border 0.3s ease!important; /* Ensure the transition is applied to these states as well */\r\n\r\n}\r\n\r\n\r\n.Data-Group_Items:hover {\r\n    /* border: 1px solid green!important; */\r\n\r\n    opacity: 1; /* Ensure the opacity is set to full */\r\n    transition: border 0.3s ease!important; /* Ensure the transition is applied to these states as well */\r\n\r\n\r\n}\r\n\r\n.Data-Group_Items.dragging{\r\n    border: 1px solid green!important;\r\n\r\n    opacity: 1; /* Ensure the opacity is set to full */   \r\n     transition: border 0.3s ease!important; /* Ensure the transition is applied to these states as well */\r\n\r\n\r\n\r\n}\r\n\r\n\r\n.nav-item {\r\n    cursor: grab;\r\n}\r\n \r\n.nav-item.hover {\r\n    border: 1px solid green!important; /* Change border style as desired */\r\n    opacity: 1; /* Example: Reduce opacity of dragging item */\r\n}\r\n\r\n\r\n\r\n.nav-item.dragging {\r\n  border:1px solid #2aff2a!important;\r\n  opacity:1\r\n}\r\n#dv_EntityContainer .nav-item:hover {\r\n  border:1px solid green!important\r\n}\r\n#Entity_Summary_Body .content {\r\n  padding-block:0\r\n}\r\n#Entity_Summary_Body-overalldiv {\r\n  width:100vw\r\n}\r\n#Entity_Summary_Wrapper {\r\n  padding:0\r\n}\r\n\r\n    #Entity_Summary_Wrapper .card-header {\r\n        /*! background: #f8f9fa; */\r\n        /*min-height: auto;*/\r\n        min-height: 50px;\r\n        padding: 0px 30px !important;\r\n        border-radius: 0 !important;\r\n        /* border-right: 1px solid #ededed; */\r\n        justify-content: space-between;\r\n        display: flex;\r\n    }\r\n\r\n    #Entity_Summary_Wrapper .card-title {\r\n        font-size: 17px;\r\n        font-weight: bold;\r\n        margin-left: 0;\r\n        padding-right: 45px;\r\n        margin-bottom: 0 !important;\r\n    }\r\n\r\n    #Entity_summary_Left .card-body {\r\n        padding: 7px 10px;\r\n        border: 1px solid #ebebeb;\r\n        overflow: hidden;\r\n    }\r\n    #Entity_summary_Left .card-body:hover{overflow: overlay;}\r\n    #Entity_summary_Right #Summary-Results .col-md-4.analytics-container{overflow: hidden; height: 100% !important;}\r\n\r\n    #Entity_summary_Right #Summary-Results .col-md-4.analytics-container:hover {overflow: overlay;}\r\n\r\n\r\n\r\n/* .Task_ID_Section {\r\n    margin-bottom: 7px;\r\n    } */\r\n.Task_ID_Section_details {\r\n    padding: 12px;\r\n}\r\n\r\n.Leave-Type {\r\n  font-weight:700;\r\n  color:#434343\r\n}\r\n.Leave-Count {\r\n  font-size:20px;\r\n  font-weight:700\r\n}\r\n#Entity_Summary_Body .text-warning {\r\n  color:#eb7900!important\r\n}\r\n#Entity_Summary_Body .material-icons {\r\n  font-family:\"Material Icons Outlined\";\r\n  font-size:19px\r\n}\r\n.Data-fields-items,\r\n.workflow-items,\r\n.Project_updates-items {\r\n    font-size: 1rem;\r\n    padding: 2px 12px 5px 0;\r\n    background: transparent;\r\n    margin-right: 5px;\r\n    border-radius: 4px;\r\n    margin-bottom: 5px;\r\n    /*! border: 1px solid #f1f1f1; */\r\n}\r\n\r\n.Ticket-Value {\r\n  font-weight:700;\r\n  display:flex\r\n}\r\n.Ticket-Title {\r\n  padding-top:6px;\r\n  font-size:1.3rem;\r\n  font-weight:700\r\n}\r\n#Tickets_details_view .card-header {\r\n    background: transparent;\r\n    border-bottom: 0;\r\n}\r\n.Action-Btns-row,\r\n.Data-fields-row,\r\n.Files-Attached-Wrapper-row,\r\n.Image-Attachment-row,\r\n.Project-description-row,\r\n.workflow-row {\r\n  padding:4px 0 inherit;\r\n  /*! border-bottom: 1px dashed #dcdcdc; */padding-left:34px;\r\n  display:flex;\r\n  flex-wrap:wrap\r\n}\r\n.Data-fields-row .material-icons,\r\n.workflow-row .material-icons {\r\n  position:relative;\r\n  top:5px;\r\n  margin-right:12px\r\n}\r\n.Data-fields-row .Ticket-Value .material-icons {\r\n  position:inherit;\r\n  margin-left:16px\r\n}\r\n#Tickets_Desc_view .material-icons,\r\n#Tickets_details_view .card-header .material-icons {\r\n  font-size:27px!important;\r\n  width:38px!important;\r\n  height:38px!important;\r\n  position:relative;\r\n  top:6px;\r\n  margin-right:12px;\r\n  text-align:center\r\n}\r\n.Data-fields-row p {\r\n  font-size:1.1rem;\r\n  line-height:26px\r\n}\r\n#Tickets_details_view .card-body {\r\n  border:0\r\n}\r\n.Ticket-Desc-Title {\r\n  display:flex;\r\n  padding:5px 0!important;\r\n  min-height:auto;\r\n  margin-top:25px;\r\n  align-items:center;\r\n  font-size:1.15rem;\r\n  font-weight:700\r\n}\r\n.Ticket-Desc-row {\r\n  padding-left:25px\r\n}\r\n.Data-fields-row p {\r\n  font-size:1.1rem;\r\n  line-height:26px;\r\n  font-weight:510\r\n}\r\n#Tickets_Desc_view .material-icons {\r\n  margin-right:17px\r\n}\r\n.Tkts-ttobar {\r\n  text-align:right;\r\n  border-bottom:1px solid #f9f9f9;\r\n  margin-top:-9px;\r\n  padding-bottom:9px\r\n}\r\n#ProcessFlow_New-container .nav.nav-tabs {\r\n  display:flex;\r\n  justify-content:space-around\r\n}\r\n#ProcessFlow_New-overalldiv .card {\r\n  box-shadow:none\r\n}\r\n#ProcessFlow_New_Right {\r\n  border:1px solid #f3f3f3;\r\n  border-width:1px 0 1px 0\r\n}\r\n#Entity_Summary_Wrapper figure {\r\n  text-align:center\r\n}\r\n#Tickets_Desc_view .Data-fields-row {\r\n  border:0\r\n}\r\n#Task_ID_Details .material-icons {\r\n  color:#939393!important\r\n}\r\n.card-title .material-icons {\r\n  margin-right:15px\r\n}\r\n.card-footer.py-5.footer-legend {\r\n  border-bottom:1px solid #eeeeef!important;\r\n  padding:10!important;\r\n  background:#f9f9fa\r\n}\r\n.footer-legend {\r\n  display:block;\r\n  font-size:13px;\r\n  text-align:center;\r\n  border-right:0;\r\n  border-radius:0!important\r\n}\r\n.legend-list {\r\n  display:inline-block;\r\n  margin-right:15px;\r\n  margin-bottom:5px\r\n}\r\n.legend-list .symbol-circle {\r\n  margin-right:6px\r\n}\r\n.legend-list .symbol .symbol-label {\r\n  width:8px;\r\n  height:8px\r\n}\r\n.symbol-label.bg-make,\r\ndiv[data-tasktype=Make] .Task-process-list::before {\r\n  background:#4b6ecc\r\n}\r\n.symbol-label.bg-approved,\r\ndiv[data-tasktype=Approve] .Task-process-list::before {\r\n  background:#5ac686\r\n}\r\n.symbol-label.bg-checked,\r\ndiv[data-tasktype=Check] .Task-process-list::before {\r\n  background:#3d821b\r\n}\r\n.symbol-label.bg-If {\r\n  background:#ecab11\r\n}\r\n.symbol-label.bg-If-else {\r\n  background:#9823e5\r\n}\r\n.symbol-label.bg-Else {\r\n  background:#23d8e5\r\n}\r\n.more-comments {\r\n  padding:0!important;\r\n  display:none!important\r\n}\r\n.task-actions-sets:hover .more-comments {\r\n  display:block!important\r\n}\r\n.task-actions-sets.d-flex:hover .more-comments {\r\n  display:block!important;\r\n  padding:0!important;\r\n  /*! margin-left: -11px; */position:relative;\r\n  top:0;\r\n  /*! border-right: 1px solid #ccc !important; */border-radius:0!important;\r\n  margin-right:0!important;\r\n  /*! border-left: 1px solid #ccc !important; */border-radius:6px!important\r\n}\r\n.task-actions-sets.d-flex:hover .btn.me-2 {\r\n  margin-right:0!important\r\n}\r\n.task-actions-sets .more-comments:first-child {\r\n  border-left:0!important\r\n}\r\n.task-actions-sets.d-flex:hover .more-comments:first-child {\r\n  border-left:0!important\r\n}\r\n.task-actions-sets.d-flex:hover {\r\n  /*! border: 1px solid #dcdcdc; */border-radius:5px;\r\n  box-shadow:0 0 14px 2px #dbdbdb\r\n}\r\n.comments-icons {\r\n  position:relative;\r\n  top:5px/*! background: tra !important; */\r\n}\r\n.Page-Title-Bar {\r\n  background:#f8f9fa;\r\n  padding:4px 10px 4px 32px!important;\r\n  font-size:18px;\r\n  font-weight:700;\r\n  margin-bottom:4px\r\n}\r\n.Page-Title {\r\n  width:24%;\r\n  display:flex;\r\n  align-content:center;\r\n  justify-content:space-between;\r\n  padding:0 15px 0 0\r\n}\r\n@media(max-width:768px) {\r\n  .Data-fields-row {\r\n    padding-left:50px!important\r\n  }\r\n  .task-more-btns {\r\n    flex-wrap:wrap;\r\n 